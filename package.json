{
	"name": "ruya-backend",
	"version": "1.0.0",
	"main": "index.js",
	"scripts": {
		"tsoa:spec": "tsoa spec",
		"build": "yarn tsoa:spec && rimraf build && tsc",
		"start": "node -r module-alias/register build/src/index.js",
		"dev": "nodemon",
		"lint": "eslint . --ext .ts",
		"lint:fix": "eslint . --ext .ts --fix",
		"format": "prettier --write .",
		"lint-staged": "lint-staged",
		"prepare": "husky install"
	},
	"lint-staged": {
		"**/*.ts": [
			"eslint --fix",
			"prettier --write"
		]
	},
	"repository": "https://github.com/bhupendra-sinha/backend-inversify.git",
	"author": "bhupendra-sinha <bhupendrasinha35413@gmail.com>",
	"license": "MIT",
	"_moduleAliases": {
		"@core": "./build/src/core",
		"@modules": "./build/src/modules",
		"@config": "./build/src/core/config",
		"@error": "./build/src/core/error",
		"@logger": "./build/src/core/logger",
		"@db": "./build/src/core/db",
		"@types": "./build/src/core/types",
		"@utils": "./build/src/utils"
	},
	"dependencies": {
		"@types/express": "^5.0.3",
		"@types/node": "^24.3.0",
		"axios": "^1.11.0",
		"cors": "^2.8.5",
		"dotenv": "^17.2.1",
		"express": "4.21.2",
		"form-data": "^4.0.4",
		"inversify": "6.2.2",
		"inversify-express-utils": "6.4.10",
		"module-alias": "^2.2.3",
		"multer": "^2.0.2",
		"nodemon": "^3.1.10",
		"pg": "^8.16.3",
		"reflect-metadata": "^0.2.2",
		"swagger-ui-express": "^5.0.1",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typeorm": "^0.3.26",
		"winston": "^3.17.0",
		"zod": "^4.0.17"
	},
	"devDependencies": {
		"@eslint/js": "^9.33.0",
		"@types/cors": "^2.8.19",
		"@types/swagger-ui-express": "^4.1.8",
		"@typescript-eslint/eslint-plugin": "^8.40.0",
		"@typescript-eslint/parser": "^8.40.0",
		"eslint": "^9.33.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-prettier": "^5.5.4",
		"globals": "^16.3.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.5",
		"prettier": "^3.6.2",
		"rimraf": "^6.0.1",
		"tsoa": "^6.6.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.40.0"
	}
}
